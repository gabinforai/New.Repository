# 서버 포트
PORT=3000

# 나중에 데이터베이스를 연결하면 여기에 접속 주소를 넣으세요
# 예: DATABASE_URL=mongodb://localhost:27017/portfolio
DATABASE_URL=

# 프론트엔드를 다른 주소/포트에서 따로 띄울 경우 CORS로 허용할 주소
# 예: FRONTEND_ORIGIN=http://localhost:5500
FRONTEND_ORIGIN=*

# ---- 관리자 로그인 설정 ----
# 비밀번호는 절대 평문으로 넣지 마세요. bcrypt 해시값만 넣습니다.
# 생성 방법: backend 폴더에서 실행
#   npm run hash-password -- "원하는비밀번호"
# 출력된 값을 아래에 붙여넣으세요.
ADMIN_PASSWORD_HASH=

# 로그인 세션(JWT) 서명용 비밀 키. 추측하기 어려운 임의의 긴 문자열로 설정하세요.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# 로그인 유지 시간(시간 단위, 기본 8시간)
ADMIN_SESSION_HOURS=8

# ---- 프로젝트 데이터 저장소 (Vercel 배포 시에만 필요) ----
# 로컬 개발 환경에서는 비워두세요 - backend/src/data/projects.json 파일을 그대로 씁니다.
# Vercel에 배포하면 파일 쓰기가 안 되기 때문에, Vercel 대시보드의
# Storage 탭에서 마켓플레이스의 Upstash(Redis)를 프로젝트에 연결하면
# 아래 두 값이 Vercel에 의해 자동으로 채워집니다. (직접 입력할 필요 없음)
KV_REST_API_URL=
KV_REST_API_TOKEN=
